SIMULATION_MODE=true
ALLOW_PRODUCTION_WRITE=false
POWERPILOT_HOST=127.0.0.1
POWERPILOT_PORT=8000
POWERPILOT_DB_PATH=./var/powerpilot.db
POWERPILOT_EVIDENCE_DIR=./runs

# Optional model gateway proxy; configure your own model through the local UI.
POWERPILOT_MODEL_PROXY=
MCP_API_KEY=

# Optional external AgentTeams runtime. Disabled for the local Demo.
AGENTTEAMS_ENABLED=false
AGENTTEAMS_LIVE_REQUIRED=true
AGENTTEAMS_RUNTIME_MODE=remote_matrix
AGENTTEAMS_TEAM_NAME=powerpilot-park-control
AGENTTEAMS_MATRIX_BASE_URL=
AGENTTEAMS_MATRIX_ACCESS_TOKEN=
AGENTTEAMS_TEAM_ROOM_ID=
AGENTTEAMS_MANAGER_USER_ID=
AGENTTEAMS_WORKER_USER_IDS=
AGENTTEAMS_REMOTE_WORKERS=powerpilot-team-leader,perception-worker,dispatch-worker,audit-worker,execution-worker
AGENTTEAMS_INSTANCE_ID=
AGENTTEAMS_EVENT_STREAM_URL=
